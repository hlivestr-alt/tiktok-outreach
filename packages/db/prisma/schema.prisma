generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ConnectionMode {
  MOCK
  DISABLED
  READ_ONLY
}

enum CampaignState {
  DRAFT
  DISCOVERING
  PREVIEW_READY
  PREVIEW_EXPIRED
  FROZEN
  QUEUED
  RUNNING
  PAUSE_REQUESTED
  PAUSED
  SAFETY_PAUSED
  COMPLETED
  COMPLETED_WITH_ERRORS
  CANCELLED
}

enum Eligibility {
  ELIGIBLE
  EXCLUDED
}

enum RecipientState {
  DISCOVERED
  ELIGIBLE
  SELECTED
  RESERVED
  QUEUED
  PROCESSING
  SENT
  FAILED
  RESTRICTED
  DELIVERY_UNKNOWN
  DELIVERY_UNKNOWN_UNRESOLVED
  CANCELLED
}

enum DeliveryState {
  PENDING
  DISPATCHING
  SENT
  FAILED_RETRYABLE
  FAILED_TERMINAL
  RESTRICTED
  DELIVERY_UNKNOWN
  DELIVERY_UNKNOWN_UNRESOLVED
  CANCELLED
}

enum SyncState {
  PENDING
  RUNNING
  COMPLETE
  PARTIAL
  FAILED
}

enum Direction {
  OUTBOUND
  INBOUND
}

enum ReconciliationState {
  PENDING
  MATCHED
  UNRESOLVED
}

enum DiscoveryRunState {
  QUEUED
  RUNNING
  BACKING_OFF
  COMPLETE
  FAILED
  CANCELLED
}

enum CreatorSyncState {
  IDLE
  RUNNING
  PAUSED
  WAITING
  EXHAUSTED
  ERROR
}

enum CreatorSyncPageState {
  RECEIVED
  COMMITTED
}

enum CreatorSearchPartitionStatus {
  QUEUED
  STARTING
  RUNNING
  WAITING_RETRY
  SATURATED
  SPLIT
  COMPLETE
  PAUSED
  ERROR
  SUPERSEDED
  DEEPLY_SATURATED
  DISABLED_BY_STRATEGY
}

enum CreatorSearchPartitionType {
  LEGACY
  V2_SEED
  EXPERIMENT
  ADAPTIVE_FOLLOWER
  ADAPTIVE_GMV
}

enum CreatorObservedSaturationState {
  UNKNOWN
  OBSERVED_SATURATED
  NOT_OBSERVED_SATURATED
}

enum CreatorBranchClassification {
  UNCLASSIFIED
  STRONG
  PRODUCTIVE
  MARGINAL
  LOW_VALUE
  EFFECTIVELY_DEAD
}

enum CreatorSchedulerClass {
  HIGH
  MEDIUM
  EXPLORATION
  LOW
}

enum HistorySyncState {
  QUEUED
  RUNNING
  BACKING_OFF
  PAUSED
  COMPLETE
  FAILED
}

enum HistorySyncMode {
  INITIAL_BACKFILL
  INCREMENTAL
}

enum HistorySyncPassKind {
  BACKFILL
  HEAD
  INCREMENTAL
}

enum HistorySyncPhase {
  LIST
  MESSAGES
}

enum HistoryConversationWorkState {
  QUEUED
  RUNNING
  COMPLETE
}

enum CreatorIdentityType {
  TIKTOK_CREATOR_OPEN_ID
  TIKTOK_CREATOR_USER_ID
  TIKTOK_CREATOR_IM_ID
}

enum CreatorIdentityLinkState {
  VERIFIED
  UNRESOLVED
}

enum TokenRefreshState {
  IDLE
  IN_PROGRESS
  FAILED
  OUTCOME_UNCERTAIN
}

model Shop {
  id                             String                       @id @default(uuid())
  name                           String
  externalShopId                 String?                      @unique
  shopCipher                     String?
  shopCode                       String?
  sellerType                     String?
  selectedForReadOnly            Boolean                      @default(false)
  region                         String                       @default("ID")
  currency                       String                       @default("IDR")
  timezone                       String                       @default("Asia/Jakarta")
  connectionMode                 ConnectionMode               @default(MOCK)
  maxRecipientsPerCampaign       Int                          @default(500)
  createdAt                      DateTime                     @default(now())
  updatedAt                      DateTime                     @updatedAt
  campaigns                      Campaign[]
  contacts                       CreatorShopContactState[]
  conversations                  Conversation[]
  reservations                   OutreachReservation[]
  syncRuns                       ContactHistorySyncRun[]
  imports                        HistoricalContactImport[]
  dailyUsage                     ShopOutboundDailyUsage[]
  dispatchEvents                 OutboundDispatchEvent[]
  discoveryRuns                  DiscoveryRun[]
  historySyncJob                 HistorySyncJob?
  historicalFacts                HistoricalContactFact[]
  safetySettingsChanges          SafetySettingsAudit[]
  providerOutboundLimiters       ProviderOutboundLimiter[]
  creatorSyncJob                 CreatorSyncJob?
  creatorSnapshots               CreatorMetricSnapshot[]
  creatorMarketplaceCategories   CreatorMarketplaceCategory[]
}

model IntegrationConnection {
  id                     String            @id @default(uuid())
  shopId                 String
  provider               String            @default("TIKTOK_SHOP")
  mode                   ConnectionMode    @default(MOCK)
  status                 String            @default("READY")
  sellerOpenId           String?
  grantedScopes          Json              @default("[]")
  capabilityStatus       Json              @default("{}")
  accessTokenCiphertext  String?
  refreshTokenCiphertext String?
  accessTokenExpiresAt   DateTime?
  refreshTokenExpiresAt  DateTime?
  lastValidatedAt        DateTime?
  lastAuthorizedAt       DateTime?
  lastRefreshAt          DateTime?
  lastRefreshFailureAt   DateTime?
  refreshFailureCount    Int               @default(0)
  refreshState           TokenRefreshState @default(IDLE)
  refreshLeaseId         String?
  refreshLeaseExpiresAt  DateTime?
  refreshStartedAt       DateTime?
  refreshUncertainAt     DateTime?
  tokenVersion           Int               @default(0)
  lastErrorCode          String?
  lastErrorMessage       String?
  lastApiRequestAt       DateTime?
  lastRequestId          String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  @@unique([shopId, provider])
}

/// Low-frequency liveness signal for the single production instance of each
/// worker role. No provider credentials or payloads are stored here.
model WorkerHeartbeat {
  role       String   @id
  instanceId String
  status     String   @default("RUNNING")
  startedAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  metadata   Json     @default("{}")
  updatedAt  DateTime @updatedAt

  @@index([lastSeenAt])
}

/// Private, durable history-worker state. Opaque provider cursors in this
/// model are never returned by an API projection.
model HistorySyncJob {
  id                              String                        @id @default(uuid())
  shopId                          String                        @unique
  state                           HistorySyncState              @default(QUEUED)
  mode                            HistorySyncMode               @default(INITIAL_BACKFILL)
  passKind                        HistorySyncPassKind           @default(BACKFILL)
  phase                           HistorySyncPhase              @default(LIST)
  pageSequence                    Int                           @default(0)
  pagesProcessed                  Int                           @default(0)
  conversationsDiscovered         Int                           @default(0)
  conversationsImported           Int                           @default(0)
  conversationsCompleted          Int                           @default(0)
  messagesImported                Int                           @default(0)
  totalProviderRequests           Int                           @default(0)
  consecutiveFailureCount         Int                           @default(0)
  cursorRecoveryCount             Int                           @default(0)
  backfillPagesSinceHead          Int                           @default(0)
  incrementalPageIndex            Int                           @default(0)
  privateBackfillPageToken        String?
  privateIncrementalPageToken     String?
  privatePendingNextPageToken     String?
  privatePendingHasMore           Boolean?
  lastProviderCode                String?
  lastErrorCategory               String?
  lastSuccessfulProviderRequestAt DateTime?
  nextAttemptAt                   DateTime?
  leaseOwner                      String?
  leaseExpiresAt                  DateTime?
  startedAt                       DateTime?
  initialCompletedAt              DateTime?
  completedAt                     DateTime?
  createdAt                       DateTime                      @default(now())
  updatedAt                       DateTime                      @updatedAt
  shop                            Shop                          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  conversations                   HistorySyncConversationWork[]

  @@index([state, nextAttemptAt])
  @@index([leaseExpiresAt])
}

/// A provider-list page is staged here before its durable cursor is advanced.
/// Message cursors are private and exact conversation IDs make replay safe.
model HistorySyncConversationWork {
  id                      String                       @id @default(uuid())
  historySyncJobId        String
  pageSequence            Int
  externalConversationId  String
  creatorImId             String
  username                String?
  avatarUrl               String?
  unreadCount             Int                          @default(0)
  state                   HistoryConversationWorkState @default(QUEUED)
  privateMessagePageToken String?
  messagesImported        Int                          @default(0)
  providerRequests        Int                          @default(0)
  completedAt             DateTime?
  createdAt               DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt
  historySyncJob          HistorySyncJob               @relation(fields: [historySyncJobId], references: [id], onDelete: Cascade)

  @@unique([historySyncJobId, pageSequence, externalConversationId])
  @@index([historySyncJobId, pageSequence, state])
}

model TikTokAuthorizationState {
  id         String    @id @default(uuid())
  stateHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([expiresAt, consumedAt])
}

/// Durable provider pacing and single-flight state. shopScope contains only a
/// local Shop.id or a non-secret authorization bucket; provider credentials,
/// shop ciphers, headers, and response bodies must never be stored here.
model ProviderReadThrottle {
  id                       String    @id @default(uuid())
  provider                 String
  shopScope                String
  operation                String
  lastRequestAt            DateTime?
  lastSuccessAt            DateTime?
  lastThrottleAt           DateTime?
  consecutiveThrottleCount Int       @default(0)
  nextPermittedAt          DateTime?
  spacingUntil             DateTime?
  lastProviderRequestId    String?
  retryAfterMs             Int?
  leaseId                  String?
  leaseExpiresAt           DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@unique([provider, shopScope, operation])
  @@index([provider, shopScope, nextPermittedAt])
  @@index([leaseExpiresAt])
}

/// Durable adaptive outbound capacity for one App x Shop x mutation endpoint.
/// appScope is a one-way app-key digest; provider credentials are never stored.
model ProviderOutboundLimiter {
  id                       String                   @id @default(uuid())
  provider                 String
  appScope                 String
  shopId                   String
  operation                String
  state                    String                   @default("HEALTHY")
  effectiveConcurrency     Int                      @default(4)
  technicalMaxConcurrency  Int                      @default(16)
  healthySuccessCount      Int                      @default(0)
  consecutiveThrottleCount Int                      @default(0)
  consecutiveFailureCount  Int                      @default(0)
  nextPermittedAt          DateTime?
  lastRequestAt            DateTime?
  lastSuccessAt            DateTime?
  lastThrottleAt           DateTime?
  lastHttpStatus           Int?
  lastBusinessCode         String?
  retryAfterMs             Int?
  quotaBlockedAt           DateTime?
  quotaCode                String?
  quotaDetail              String?
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  shop                     Shop                     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  permits                  ProviderOutboundPermit[]
  events                   ProviderOutboundEvent[]

  @@unique([provider, appScope, shopId, operation])
  @@index([shopId, state, nextPermittedAt])
}

/// Short-lived cross-process provider permits. Expiry is crash recovery only;
/// healthy requests release their permit immediately.
model ProviderOutboundPermit {
  id        String                  @id @default(uuid())
  limiterId String
  owner     String                  @unique
  expiresAt DateTime
  createdAt DateTime                @default(now())
  limiter   ProviderOutboundLimiter @relation(fields: [limiterId], references: [id], onDelete: Cascade)

  @@index([limiterId, expiresAt])
}

/// Compact request events support rolling one-minute outbound observability.
model ProviderOutboundEvent {
  id           String                  @id @default(uuid())
  limiterId    String
  outcome      String
  httpStatus   Int?
  businessCode String?
  occurredAt   DateTime                @default(now())
  limiter      ProviderOutboundLimiter @relation(fields: [limiterId], references: [id], onDelete: Cascade)

  @@index([limiterId, occurredAt])
  @@index([occurredAt])
}

model Creator {
  id                 String                    @id @default(uuid())
  creatorOpenId      String?                   @unique
  creatorUserId      String?                   @unique
  creatorImId        String?                   @unique
  username           String?
  nickname           String?
  selectionRegion    String                    @default("ID")
  avatarUrl          String?
  profileUri         String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  snapshots          CreatorMetricSnapshot[]
  contacts           CreatorShopContactState[]
  conversations      Conversation[]
  recipients         CampaignRecipient[]
  reservations       OutreachReservation[]
  providerIdentities CreatorProviderIdentity[]
}

model CreatorProviderIdentity {
  id           String                   @id @default(uuid())
  creatorId    String
  provider     String                   @default("TIKTOK_SHOP")
  identityType CreatorIdentityType
  identifier   String
  linkState    CreatorIdentityLinkState @default(VERIFIED)
  evidenceType String
  evidence     Json                     @default("{}")
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  creator      Creator                  @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([provider, identityType, identifier])
  @@index([creatorId, linkState])
}

model CreatorIdentityAudit {
  id              String   @id @default(uuid())
  provider        String   @default("TIKTOK_SHOP")
  action          String
  sourceCreatorId String
  targetCreatorId String?
  evidenceType    String
  evidence        Json     @default("{}")
  createdAt       DateTime @default(now())

  @@index([sourceCreatorId, createdAt])
  @@index([targetCreatorId, createdAt])
}

model CreatorMetricSnapshot {
  id              String              @id @default(uuid())
  creatorId       String
  shopId          String?
  followerCount   Int?
  categoryIds     Json
  gmvAmount       Decimal?            @db.Decimal(24, 2)
  gmvCurrency     String?
  unitsSold       Int?
  avgVideoViews   Int?
  avgLiveViewers  Int?
  engagementRate  Decimal?            @db.Decimal(10, 6)
  metrics         Json                @default("{}")
  rawPayload      Json                @default("{}")
  sourceFetchedAt DateTime
  sourcePageKey   String?
  creator         Creator             @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  shop            Shop?               @relation(fields: [shopId], references: [id], onDelete: Cascade)
  recipients      CampaignRecipient[]

  @@unique([creatorId, sourcePageKey])
  @@index([creatorId, sourceFetchedAt])
  @@index([shopId, sourceFetchedAt])
}

/// One durable continuation stream per shop. Provider cursors are private and
/// never returned by the public API projection.
model CreatorSyncJob {
  id                     String                   @id @default(uuid())
  shopId                 String                   @unique
  state                  CreatorSyncState         @default(PAUSED)
  privateSearchKey       String?
  privateNextPageToken   String?
  pagesCompleted         Int                      @default(10)
  creatorsFetched        Int                      @default(200)
  creatorsFetchedThisRun Int                      @default(0)
  pauseRequested         Boolean                  @default(false)
  marketplaceRetryDelaySeconds Int                  @default(3)
  nextAttemptAt          DateTime?
  startedAt              DateTime?
  lastPageAt             DateTime?
  lastSuccessAt          DateTime?
  lastError              String?
  lastProviderCode       String?
  currentStage           String                   @default("PAUSED")
  lastAttemptAt          DateTime?
  lastResponseAt         DateTime?
  lastAttemptPage        Int?
  lastHttpStatus         Int?
  lastTikTokCode         String?
  lastSafeError          String?
  lastCreatorsReturned   Int?
  lastCreatorsAdded      Int?
  lastDuplicates         Int?
  spreadsheetId          String
  sheetImportedAt        DateTime?
  leaseId                String?
  leaseExpiresAt         DateTime?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  shop                   Shop                     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  pages                  CreatorSyncPage[]
  events                 CreatorSyncEvent[]
  partitions             CreatorSearchPartition[]
  currentPartitionId     String?                  @unique
  currentPartition       CreatorSearchPartition?  @relation("CurrentCreatorPartition", fields: [currentPartitionId], references: [id], onDelete: SetNull)
  crawlerGeneration      Int                      @default(1)
  partitionClaimSequence Int                      @default(0)

  @@index([state, nextAttemptAt])
  @@index([leaseExpiresAt])
}

/// Safe, durable activity records for the Creator Database UI. Provider
/// credentials and opaque pagination values are deliberately excluded.
model CreatorSyncEvent {
  id                       String                  @id @default(uuid())
  creatorSyncJobId         String
  stage                    String
  pageNumber               Int?
  httpStatus               Int?
  tiktokCode               String?
  googleApiCode            String?
  retryable                Boolean?
  safeMessage              String?
  creatorsReturned         Int?
  creatorsAdded            Int?
  duplicates               Int?
  nextAttemptAt            DateTime?
  occurredAt               DateTime                @default(now())
  creatorSyncJob           CreatorSyncJob          @relation(fields: [creatorSyncJobId], references: [id], onDelete: Cascade)
  creatorSearchPartitionId String?
  partitionKey             String?
  partitionLabel           String?
  creatorSearchPartition   CreatorSearchPartition? @relation(fields: [creatorSearchPartitionId], references: [id], onDelete: SetNull)

  @@index([creatorSyncJobId, occurredAt])
}

/// A successful provider response is staged before either Sheets work or
/// cursor advancement. Replaying this row is safe because creators reconcile
/// by Creator Open ID and snapshots reconcile by sourcePageKey.
model CreatorSyncPage {
  id                       String                  @id @default(uuid())
  creatorSyncJobId         String
  state                    CreatorSyncPageState    @default(RECEIVED)
  pageNumber               Int
  privateRequestToken      String
  privateNextToken         String?
  privateSearchKey         String
  providerHasMore          Boolean
  creatorsReturned         Int
  newUniqueCreators        Int?
  duplicateRows            Int?
  newCreatorOpenIds        String[]                @default([])
  payload                  Json
  sheetsAttemptCount       Int                     @default(0)
  nextSheetsAttemptAt      DateTime?
  lastSheetsHttpStatus     Int?
  lastSheetsApiCode        String?
  lastSheetsRetryable      Boolean?
  lastSheetsError          String?
  receivedAt               DateTime                @default(now())
  committedAt              DateTime?
  creatorSyncJob           CreatorSyncJob          @relation(fields: [creatorSyncJobId], references: [id], onDelete: Cascade)
  creatorSearchPartitionId String?
  creatorSearchPartition   CreatorSearchPartition? @relation(fields: [creatorSearchPartitionId], references: [id], onDelete: SetNull)

  @@unique([creatorSyncJobId, privateRequestToken])
  @@index([creatorSyncJobId, state, pageNumber])
}

/// Cached TikTok Shop category metadata. V1 creator crawling enables the
/// documented parent categories (root nodes) and keeps the full fetched tree.
model CreatorMarketplaceCategory {
  id                        String   @id @default(uuid())
  shopId                    String
  categoryId                String
  categoryName              String
  parentCategoryId          String?
  level                     Int
  enabledForCreatorCrawl    Boolean  @default(false)
  availableForCreatorFilter Boolean  @default(true)
  sortOrder                 Int
  isLeaf                    Boolean  @default(false)
  fetchedAt                 DateTime
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  shop                      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, categoryId])
  @@index([shopId, enabledForCreatorCrawl, sortOrder])
}

/// Durable Marketplace search sequence. Opaque cursors remain backend-only.
model CreatorSearchPartition {
  id                            String                         @id @default(uuid())
  creatorSyncJobId              String
  partitionKey                  String
  generation                    Int                            @default(1)
  partitionType                 CreatorSearchPartitionType     @default(LEGACY)
  adaptiveDepth                 Int                            @default(0)
  categoryId                    String?
  categoryName                  String
  categoryChildId               String?
  categoryChildName             String?
  followerBucket                String?
  followersMin                  Int?
  followersMax                  Int?
  gmvBucket                     String?
  gmvRange                      String?
  parentPartitionId             String?
  status                        CreatorSearchPartitionStatus   @default(QUEUED)
  queuePosition                 BigInt
  privateSearchKey              String?
  privateNextPageToken          String?
  pagesCompleted                Int                            @default(0)
  rowsReturned                  Int                            @default(0)
  uniqueCreatorsAdded           Int                            @default(0)
  duplicates                    Int                            @default(0)
  marketplaceRequests           Int                            @default(0)
  throttleAttempts              Int                            @default(0)
  newCreatorsPerRequest         Decimal?                       @db.Decimal(14, 6)
  duplicateRate                 Decimal?                       @db.Decimal(10, 8)
  originalYield                 Decimal?                       @db.Decimal(10, 8)
  incrementalYield              Decimal?                       @db.Decimal(10, 8)
  combinedChildIncrementalYield Decimal?                       @db.Decimal(10, 8)
  observedSaturationState       CreatorObservedSaturationState @default(UNKNOWN)
  branchClassification          CreatorBranchClassification    @default(UNCLASSIFIED)
  followerSplitExplored         Boolean                        @default(false)
  followerRecursionTerminal     Boolean                        @default(false)
  gmvSplitCreated               Boolean                        @default(false)
  priorityScore                 Decimal                        @default(0) @db.Decimal(18, 6)
  priorityReason                String?
  priorityUpdatedAt             DateTime?
  schedulerClass                CreatorSchedulerClass?
  schedulerClaimSequence        Int?
  schedulerCategoryRows         Decimal?                       @db.Decimal(18, 3)
  schedulerCategoryYield        Decimal?                       @db.Decimal(10, 8)
  schedulerCategoryWeight       Decimal?                       @db.Decimal(12, 6)
  schedulerFollowerRows         Decimal?                       @db.Decimal(18, 3)
  schedulerFollowerYield        Decimal?                       @db.Decimal(10, 8)
  schedulerFollowerWeight       Decimal?                       @db.Decimal(12, 6)
  schedulerAncestorYield        Decimal?                       @db.Decimal(10, 8)
  schedulerNewPerSuccessfulPage Decimal?                       @db.Decimal(14, 6)
  mayStillBeDense               Boolean                        @default(false)
  categoryChildIds              String[]                       @default([])
  business16032001RetryCount    Int                            @default(0)
  business16032001RetryPage     Int?
  createdAt                     DateTime                       @default(now())
  startedAt                     DateTime?
  completedAt                   DateTime?
  lastRequestAt                 DateTime?
  lastSuccessAt                 DateTime?
  lastError                     String?
  updatedAt                     DateTime                       @updatedAt
  creatorSyncJob                CreatorSyncJob                 @relation(fields: [creatorSyncJobId], references: [id], onDelete: Cascade)
  activeForJob                  CreatorSyncJob?                @relation("CurrentCreatorPartition")
  parentPartition               CreatorSearchPartition?        @relation("PartitionChildren", fields: [parentPartitionId], references: [id], onDelete: SetNull)
  children                      CreatorSearchPartition[]       @relation("PartitionChildren")
  pages                         CreatorSyncPage[]
  events                        CreatorSyncEvent[]

  @@unique([creatorSyncJobId, partitionKey])
  @@index([creatorSyncJobId, status, queuePosition])
  @@index([creatorSyncJobId, generation, status, queuePosition])
  @@index([creatorSyncJobId, partitionType, status, priorityScore, queuePosition])
  @@index([creatorSyncJobId, schedulerClass, schedulerClaimSequence])
  @@index([parentPartitionId])
}

model CreatorShopContactState {
  id                   String    @id @default(uuid())
  shopId               String
  creatorId            String
  firstContactedAt     DateTime?
  lastContactedAt      DateTime?
  contactCount         Int       @default(0)
  lastCampaignId       String?
  lastDeliveryId       String?
  doNotContact         Boolean   @default(false)
  unresolvedDelivery   Boolean   @default(false)
  latestReplyStatus    String    @default("NONE")
  historyCoverageStart DateTime?
  updatedAt            DateTime  @updatedAt
  shop                 Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  creator              Creator   @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([shopId, creatorId])
  @@index([shopId, lastContactedAt])
}

model Conversation {
  id                     String                @id @default(uuid())
  shopId                 String
  creatorId              String
  externalConversationId String                @unique
  unreadCount            Int                   @default(0)
  lastSyncedAt           DateTime?
  shop                   Shop                  @relation(fields: [shopId], references: [id], onDelete: Cascade)
  creator                Creator               @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  messages               ConversationMessage[]
  deliveries             OutreachDelivery[]

  @@index([shopId, creatorId])
}

model ConversationMessage {
  id                String       @id @default(uuid())
  conversationId    String
  externalMessageId String       @unique
  direction         Direction
  messageType       String       @default("TEXT")
  content           String       @db.Text
  contentHash       String
  providerCreatedAt DateTime
  importSource      String
  rawPayload        Json         @default("{}")
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, providerCreatedAt])
}

model ContactHistorySyncRun {
  id                   String    @id @default(uuid())
  shopId               String
  source               String
  state                SyncState @default(PENDING)
  cursor               Json?
  earliestCoveredAt    DateTime?
  latestCoveredAt      DateTime?
  conversationsScanned Int       @default(0)
  messagesImported     Int       @default(0)
  unmatchedCount       Int       @default(0)
  error                String?
  startedAt            DateTime?
  completedAt          DateTime?
  createdAt            DateTime  @default(now())
  shop                 Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
}

model HistoricalContactImport {
  id             String                    @id @default(uuid())
  shopId         String
  sourceName     String
  sourceHash     String
  state          SyncState                 @default(PENDING)
  rowCount       Int                       @default(0)
  importedCount  Int                       @default(0)
  duplicateCount Int                       @default(0)
  unmatchedCount Int                       @default(0)
  conflictCount  Int                       @default(0)
  createdAt      DateTime                  @default(now())
  completedAt    DateTime?
  shop           Shop                      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  records        HistoricalContactRecord[]

  @@unique([shopId, sourceHash])
}

model HistoricalContactRecord {
  id                   String                  @id @default(uuid())
  importId             String
  shopId               String
  sourceRecordId       String
  identityKey          String
  creatorOpenId        String?
  conversationId       String?
  externalMessageId    String?
  contactedAt          DateTime
  sendStatus           String
  campaignName         String?
  messageContent       String?                 @db.Text
  resolutionState      String
  contactFactId        String?
  supersededByRecordId String?
  historicalImport     HistoricalContactImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  contactFact          HistoricalContactFact?  @relation(fields: [contactFactId], references: [id])

  @@unique([importId, sourceRecordId])
  @@index([shopId, identityKey])
}

model HistoricalContactFact {
  id                String                    @id @default(uuid())
  shopId            String
  identityKey       String
  externalSource    String
  sourceRecordId    String?
  externalMessageId String?
  creatorOpenId     String?
  conversationId    String?
  contactedAt       DateTime
  sendStatus        String
  resolutionState   String
  currentRecordId   String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  shop              Shop                      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  records           HistoricalContactRecord[]

  @@unique([shopId, identityKey])
  @@index([shopId, creatorOpenId, contactedAt])
}

model Campaign {
  id                String                  @id @default(uuid())
  shopId            String
  name              String
  productName       String
  targetCount       Int
  candidateLimit    Int
  cooldownDays      Int
  messageTemplate   String                  @db.Text
  filters           Json
  rankingMetric     String
  rankingDirection  String                  @default("DESC")
  state             CampaignState           @default(DRAFT)
  version           Int                     @default(1)
  summary           Json                    @default("{}")
  truncated         Boolean                 @default(false)
  frozenAt          DateTime?
  freezeExpiresAt   DateTime?
  frozenFilters     Json?
  frozenTemplate    String?                 @db.Text
  frozenContext     Json?
  dispatchCount     Int                     @default(0)
  safetyPauseReason String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  shop              Shop                    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  recipients        CampaignRecipient[]
  deliveries        OutreachDelivery[]
  dispatchEvents    OutboundDispatchEvent[]
  outboxEntries     QueueOutbox[]
  discoveryRun      DiscoveryRun?

  @@index([shopId, state])
}

/// Durable, private Marketplace discovery progress. Provider pagination values
/// are intentionally isolated from Campaign, which is a public API object.
model DiscoveryRun {
  id                       String               @id @default(uuid())
  campaignId               String               @unique
  shopId                   String
  state                    DiscoveryRunState    @default(QUEUED)
  requestedTarget          Int
  candidateLimit           Int
  pagesFetched             Int                  @default(0)
  candidatesFetched        Int                  @default(0)
  consecutiveThrottleCount Int                  @default(0)
  totalProviderRequests    Int                  @default(0)
  lastProviderCode         String?
  lastProviderRequestAt    DateTime?
  nextAttemptAt            DateTime?
  providerSearchKey        String?
  providerNextPageToken    String?
  providerHasMore          Boolean              @default(true)
  failureCategory          String?
  leaseId                  String?
  leaseExpiresAt           DateTime?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  completedAt              DateTime?
  campaign                 Campaign             @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  shop                     Shop                 @relation(fields: [shopId], references: [id], onDelete: Cascade)
  candidates               DiscoveryCandidate[]

  @@index([state, nextAttemptAt])
  @@index([shopId, state])
  @@index([leaseExpiresAt])
}

/// Private staging rows make provider-page replay safe and creator persistence
/// idempotent by exact TikTok Creator Open ID.
model DiscoveryCandidate {
  id               String       @id @default(uuid())
  discoveryRunId   String
  creatorOpenId    String
  discoveryOrdinal Int
  candidate        Json
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  discoveryRun     DiscoveryRun @relation(fields: [discoveryRunId], references: [id], onDelete: Cascade)

  @@unique([discoveryRunId, creatorOpenId])
  @@index([discoveryRunId, discoveryOrdinal])
}

model CampaignRecipient {
  id                    String                @id @default(uuid())
  campaignId            String
  creatorId             String
  snapshotId            String
  discoveryOrdinal      Int
  eligibility           Eligibility
  skipReason            String?
  skipDetail            String?
  rankingValue          Decimal               @db.Decimal(24, 6)
  selected              Boolean               @default(false)
  frozenMessage         String?               @db.Text
  contentHash           String?
  creatorOpenIdSnapshot String?
  recipientSnapshot     Json?
  frozenRank            Int?
  state                 RecipientState        @default(DISCOVERED)
  replyStatus           String                @default("NONE")
  campaign              Campaign              @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creator               Creator               @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  snapshot              CreatorMetricSnapshot @relation(fields: [snapshotId], references: [id])
  delivery              OutreachDelivery?
  reservation           OutreachReservation?

  @@unique([campaignId, creatorId])
  @@index([campaignId, selected, state])
}

model OutreachReservation {
  id                  String            @id @default(uuid())
  shopId              String
  creatorId           String
  campaignRecipientId String            @unique
  expiresAt           DateTime
  shop                Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  creator             Creator           @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  recipient           CampaignRecipient @relation(fields: [campaignRecipientId], references: [id], onDelete: Cascade)

  @@unique([shopId, creatorId])
}

model OutreachDelivery {
  id                  String                      @id @default(uuid())
  campaignId          String
  campaignRecipientId String                      @unique
  conversationId      String?
  deterministicKey    String                      @unique
  contentHash         String
  state               DeliveryState               @default(PENDING)
  externalMessageId   String?                     @unique
  providerRequestId   String?
  attemptCount        Int                         @default(0)
  lastAttemptedAt     DateTime?
  firstDispatchedAt   DateTime?
  sentAt              DateTime?
  lastErrorCode       String?
  lastErrorDetail     String?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  campaign            Campaign                    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  recipient           CampaignRecipient           @relation(fields: [campaignRecipientId], references: [id], onDelete: Cascade)
  conversation        Conversation?               @relation(fields: [conversationId], references: [id])
  attempts            DeliveryAttempt[]
  reconciliations     DeliveryReconciliationRun[]
  outboxEntry         QueueOutbox?
}

model QueueOutbox {
  id                 String           @id @default(uuid())
  campaignId         String
  deliveryId         String           @unique
  recipientId        String           @unique
  queueName          String           @default("outreach")
  jobName            String           @default("send")
  deterministicJobId String           @unique
  state              String           @default("PENDING")
  enqueueAttempts    Int              @default(0)
  availableAt        DateTime         @default(now())
  enqueuedAt         DateTime?
  lastError          String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  campaign           Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  delivery           OutreachDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([state, availableAt])
  @@index([campaignId])
}

model DeliveryAttempt {
  id                 String           @id @default(uuid())
  deliveryId         String
  attemptNumber      Int
  outcome            String
  providerCode       String?
  providerHttpStatus Int?
  providerRequestId  String?
  startedAt          DateTime
  completedAt        DateTime?
  delivery           OutreachDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@unique([deliveryId, attemptNumber])
}

model DeliveryReconciliationRun {
  id               String              @id @default(uuid())
  deliveryId       String
  attemptNumber    Int
  state            ReconciliationState @default(PENDING)
  matchedMessageId String?
  evidence         Json                @default("{}")
  scheduledFor     DateTime
  completedAt      DateTime?
  delivery         OutreachDelivery    @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@unique([deliveryId, attemptNumber])
}

model OutboundDispatchEvent {
  id           String   @id @default(uuid())
  shopId       String
  campaignId   String
  deliveryId   String
  dispatchedAt DateTime @default(now())
  shop         Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  campaign     Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([shopId, dispatchedAt])
  @@index([deliveryId])
}

model ShopOutboundDailyUsage {
  id            String   @id @default(uuid())
  shopId        String
  shopDate      DateTime @db.Date
  dispatchCount Int      @default(0)
  updatedAt     DateTime @updatedAt
  shop          Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, shopDate])
}

model AuditEvent {
  id         String   @id @default(uuid())
  shopId     String
  campaignId String?
  eventType  String
  actor      String   @default("local-operator")
  payload    Json     @default("{}")
  createdAt  DateTime @default(now())

  @@index([shopId, createdAt])
}

model SafetySettingsAudit {
  id              String   @id @default(uuid())
  shopId          String
  actor           String   @default("system-initialization")
  source          String
  previousValues  Json?
  effectiveValues Json
  createdAt       DateTime @default(now())
  shop            Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, createdAt])
}
