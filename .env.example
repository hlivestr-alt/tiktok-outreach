DATABASE_URL=postgresql://affiliate:affiliate@localhost:5432/affiliate_outreach?schema=public
REDIS_URL=redis://localhost:6379
PORT=4000
HOST=127.0.0.1
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
APP_MODE=mock
# mock (local fixtures), read_only (no mutation adapter), or live (explicitly gated)
OUTBOUND_MODE=read_only
# Exact acknowledgement required with APP_MODE=read_only and OUTBOUND_MODE=live.
ENABLE_LIVE_TIKTOK_OUTBOUND=NOT_ACKNOWLEDGED
# In read_only production, these four values must belong only to the dedicated TikTok Outreach app.
# Never copy the TikTok Orders/n8n app credentials into this project.
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_SERVICE_ID=
TIKTOK_TOKEN_ENCRYPTION_KEY=
TIKTOK_REDIRECT_URI=http://127.0.0.1:4000/api/v1/integrations/tiktok/callback
TIKTOK_API_BASE_URL=https://open-api.tiktokglobalshop.com
TIKTOK_AUTH_BASE_URL=https://auth.tiktok-shops.com
TIKTOK_AUTHORIZATION_BASE_URL=https://services.tiktokshop.com/open/authorize
TIKTOK_TOKEN_REFRESH_MARGIN_SECONDS=1800
MARKETPLACE_SUCCESS_SPACING_MS=1000
DISCOVERY_POLL_INTERVAL_MS=1000
HISTORY_SYNC_POLL_INTERVAL_MS=1000
HISTORY_SYNC_SUCCESS_SPACING_MS=1000
HISTORY_SYNC_INCREMENTAL_INTERVAL_MS=21600000
HISTORY_SYNC_INCREMENTAL_PAGES=3
HISTORY_SYNC_HEAD_EVERY_BACKFILL_PAGES=5
SHOP_TIMEZONE=Asia/Jakarta
MAX_RECIPIENTS_PER_CAMPAIGN=100
MAX_DISPATCH_ATTEMPTS_PER_CAMPAIGN=400
MAX_SENDS_PER_DAY=100
MAX_SENDS_PER_HOUR=20
MAX_DISPATCHES_PER_MINUTE=5
OUTBOUND_PACING_MS=10000
MOCK_RECONCILIATION_DELAYS_MS=300000,1800000,7200000
# Production runtime metadata and liveness. Startup scripts populate build identity.
RUNTIME_ENV=development
WORKER_HEARTBEAT_INTERVAL_MS=15000
WORKER_STALE_AFTER_MS=45000
TIKTOK_TOKEN_MAINTENANCE_INTERVAL_MS=300000
