TIKTOK_APP_SECRET=
TIKTOK_SERVICE_ID=
TIKTOK_TOKEN_ENCRYPTION_KEY=
# Customer Support app: category metadata refresh only. These values are never used for Marketplace creator requests.
# Use the access token and shop cipher issued for this app's authorization of the same Indonesian seller.
